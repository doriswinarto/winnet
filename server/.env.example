# ── Required ────────────────────────────────────────────────────────────────
# Portal API key. Server-side only: never put this in app/, never prefix it
# VITE_ (Vite inlines those into the browser bundle), never log it.
#
# The panel binds this key to the Daftar IP entries you register for it, so it
# only works from this machine's public IP. That is deliberate — register the
# portal node's IP, and nothing else.
WINNET_PORTAL_API_KEY=sk_xxx.yyy

# ── Panel ───────────────────────────────────────────────────────────────────
WINNET_PANEL_BASE_URL=https://registrasi.winartha.net.id
WINNET_PANEL_TIMEOUT_MS=10000

# ── This node ───────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
# Directory of the built SPA, relative to server/. Served same-origin so the
# session cookie needs no CORS and can stay SameSite=Strict.
WINNET_STATIC_DIR=../app/dist
# Number of proxy hops to trust for the client IP. 0 if directly exposed.
WINNET_TRUST_PROXY=0
# Leave true. Only set false for local HTTP development.
WINNET_SECURE_COOKIES=true

# ── Sessions ────────────────────────────────────────────────────────────────
WINNET_SESSION_TTL=43200
WINNET_REMEMBER_TTL=2592000

# ── OTP throttling (WhatsApp sends cost money and reach real phones) ─────────
WINNET_OTP_MAX=3
WINNET_OTP_MAX_IP=30
WINNET_OTP_WINDOW_SEC=900

# ── Provisional panel field names ───────────────────────────────────────────
# Only /data has a documented body ({token, bagian}). The names below are best
# guesses for the other endpoints; override any that the panel rejects rather
# than editing code. GET /bff/diagnostik lists response fields that did not
# match.
#WINNET_FIELD_OTP_IDENTIFIER=identifier
#WINNET_FIELD_OTP_CODE=kode
#WINNET_FIELD_REMEMBER_TOKEN=token
#WINNET_FIELD_LAPOR_KATEGORI=kategori
#WINNET_FIELD_LAPOR_KETERANGAN=keterangan
#WINNET_FIELD_UPGRADE_PAKET=paket_id
#WINNET_FIELD_SPEED_DOWN=download
#WINNET_FIELD_SPEED_UP=upload
#WINNET_FIELD_SPEED_LATENCY=latency
