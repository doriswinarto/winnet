# Public origin of the portal node — required for the Android build, ignored
# by the browser build (which is served by the node itself and uses a relative
# /bff path).
#
# This is a public URL, not a secret. The panel API key lives only in
# server/.env and must never appear in this file: anything VITE_-prefixed is
# inlined into the JavaScript that ships to every user.
VITE_PORTAL_ORIGIN=https://portal.winartha.net.id
